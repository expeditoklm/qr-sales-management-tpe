# ══════════════════════════════════════════════════════════
# QuickSellPay Backend — Variables d'environnement v5.0
# Copier ce fichier en .env et remplir les valeurs manquantes
# ══════════════════════════════════════════════════════════

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=change-me-min-32-chars-OBLIGATOIRE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
INVITE_TOKEN_EXPIRE_HOURS=48
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ── Super-admin ──────────────────────────────────────────
SUPERADMIN_EMAIL=admin@votre-domaine.com
SUPERADMIN_PASSWORD=ChangeMe123!

# ── CORS ─────────────────────────────────────────────────
# En prod : mettre uniquement les domaines autorisés
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000

# ── Rate limiting ────────────────────────────────────────
RATE_LIMIT_VERIFY_REQUESTS=10
RATE_LIMIT_VERIFY_WINDOW=60
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW=60

# ── Plans & quotas ───────────────────────────────────────
PLAN_FREE_PRODUCTS=10
PLAN_FREE_USERS=1
PLAN_FREE_TRANSACTIONS=100
PLAN_BASIC_PRODUCTS=100
PLAN_BASIC_USERS=3
PLAN_BASIC_TRANSACTIONS=1000
PLAN_PRO_PRODUCTS=1000
PLAN_PRO_USERS=10
PLAN_PRO_TRANSACTIONS=10000
PLAN_ENTERPRISE_PRODUCTS=999999
PLAN_ENTERPRISE_USERS=999999
PLAN_ENTERPRISE_TRANSACTIONS=999999

# ── Chemins ──────────────────────────────────────────────
DATA_DIR=./data
BACKUP_DIR=./backups

# ══════════════════════════════════════════════════════════
# BASE DE DONNÉES
# ══════════════════════════════════════════════════════════
# sqlite = fichiers locaux dans DATA_DIR (dev uniquement)
# mysql  = base MySQL/MariaDB unique (production recommandé)
DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=quicksellpay
MYSQL_USER=quicksellpay
MYSQL_PASSWORD=MotDePasseSecurise!

# ══════════════════════════════════════════════════════════
# STOCKAGE FICHIERS
# ══════════════════════════════════════════════════════════
# local = ./static/images/ (dev uniquement, ne pas utiliser en prod multi-serveur)
# s3    = AWS S3 ou tout stockage compatible S3 (Cloudflare R2, MinIO…)
# r2    = alias pour s3 (même driver boto3)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=quicksellpay-images
STORAGE_REGION=auto
# Cloudflare R2 : https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# URL publique CDN devant le bucket (ex : https://cdn.quicksellpay.com)
STORAGE_PUBLIC_BASE_URL=https://cdn.quicksellpay.com

# Taille max des uploads en Mo (défaut : 10)
MAX_UPLOAD_SIZE_MB=10

# ══════════════════════════════════════════════════════════
# REDIS — rate limiting multi-workers
# ══════════════════════════════════════════════════════════
# Si vide, fallback in-memory (ok pour 1 seul worker)
# Format : redis://:password@host:6379/0
REDIS_URL=redis://localhost:6379/0

# ══════════════════════════════════════════════════════════
# SENTRY — monitoring des erreurs
# ══════════════════════════════════════════════════════════
# Créer un projet sur https://sentry.io (gratuit jusqu'à 5k events/mois)
SENTRY_DSN=
# Pourcentage de transactions tracées pour la perf (0.0 à 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.05

# ══════════════════════════════════════════════════════════
# EMAIL SMTP
# ══════════════════════════════════════════════════════════
MAIL_ENABLED=false
MAIL_HOST=smtp.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@quicksellpay.com
MAIL_USE_TLS=true
PUBLIC_APP_BASE_URL=https://quicksellpay.tunelaf.com

# ══════════════════════════════════════════════════════════
# STRIPE — abonnements (optionnel)
# ══════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
